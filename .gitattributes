# Normalize line endings to LF on checkout
* text=auto eol=lf

# Explicitly declare text files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf

# Binary files — do not modify
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.woff binary
*.woff2 binary
